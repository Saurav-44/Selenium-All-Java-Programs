package com.LocatorCasestudy;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.testng.annotations.AfterMethod;
import org.testng.annotations.DataProvider;
import org.testng.annotations.Test;

public class CaseStudy9 {

	WebDriver driver;

	@Test(dataProvider = "OpenCart")
	public void Browser(String UserName, String Password) throws Exception {

		driver = new ChromeDriver();
		driver.navigate().to("https://demo.opencart.com/en-gb?route=account/login");
		Thread.sleep(30000);
		driver.manage().window().maximize();
		driver.findElement(By.name("email")).sendKeys(UserName);
		driver.findElement(By.name("password")).sendKeys(Password);
		driver.findElement(By.xpath("//button[normalize-space()='Login']")).click();
		Thread.sleep(5000);

	}

	@DataProvider(name = "OpenCart")
	public Object[][] passData() {

		Object[][] data = new Object[2][2];

		data[0][0] = "saurav@312";
		data[0][1] = "saurav653";

		data[1][0] = "bappi@534";
		data[1][1] = "bappi564";

		return data;

	}

	@AfterMethod
	public void tearDown() {
		driver.quit();
	}

}
