package com.ApachePOI;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;

import org.apache.poi.xssf.usermodel.XSSFSheet;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;


public class ApachePOITesting {
	
	public static void main(String[] args) throws Exception {

		File src = new File("D:\\ApacheTestData\\Workbook1.xlsx\\");
		FileInputStream fis = new FileInputStream(src);
		
		XSSFWorkbook wb = new XSSFWorkbook(fis);
		XSSFSheet sheet1 = wb.getSheetAt(0);
		
		String data0 = sheet1.getRow(1).getCell(1).getStringCellValue();
		System.out.println("Data form Excel is ...." + data0);
		
		String data1 = sheet1.getRow(1).getCell(2).getStringCellValue();
		System.out.println("Data form Excel is ...." + data1);
		
		wb.close();
	}
	
	
	
}
